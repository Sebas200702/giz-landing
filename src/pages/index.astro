---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import EligibilityBar from "../components/EligibilityBar.astro";
import Audience from "../components/Audience.astro";
import ProgramSteps from "../components/ProgramSteps.astro";
import Training from "../components/Training.astro";
import Curriculum from "../components/Curriculum.astro";
import Companies from "../components/Companies.astro";
import Registration from "../components/Registration.astro";
import Faq from "../components/Faq.astro";
import Footer from "../components/Footer.astro";
---

<Layout>
  <div id="top">
    <Header />
    <main id="main-content">
      <Hero />
      <EligibilityBar />
      <Audience />
      <ProgramSteps />
      <Training />
      <Curriculum />
      <Companies />
      <Registration />
      <Faq />
       </main>
    <Footer />
  </div>
</Layout>
