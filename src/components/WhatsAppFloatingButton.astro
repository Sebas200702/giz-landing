---
import IconWhatsapp from "./IconWhatsapp.astro";
import { whatsappHref } from "../data/site";
---

<a
  id="wa-float"
  href={whatsappHref()}
  target="_blank"
  rel="noopener"
  aria-label="Escríbenos por WhatsApp"
  class="wa-float fixed right-5 bottom-5 z-40 flex h-14 w-14 items-center justify-center rounded-full bg-coral-strong text-white shadow-lg md:hidden"
>
  <IconWhatsapp size={28} />
</a>

<style>
  .wa-float {
    opacity: 0;
    transform: scale(0.8) translateY(8px);
    pointer-events: none;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .wa-float.is-visible {
    opacity: 1;
    transform: scale(1) translateY(0);
    pointer-events: auto;
  }
</style>

<script>
  const btn = document.getElementById("wa-float");
  const hero = document.getElementById("hero");

  if (btn && hero) {
    const io = new IntersectionObserver(
      ([entry]) => btn.classList.toggle("is-visible", !entry.isIntersecting),
      { threshold: 0 },
    );
    io.observe(hero);
  }
</script>
