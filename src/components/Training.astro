---
import Icon from "./Icon.astro";
import { TRAINING } from "../data/site";
import { ACCENTS, type Accent } from "../utils/colors";
---

<section id="formacion" class="scroll-mt-24 py-8 sm:py-20" style="content-visibility: auto">
  <div class="wrap">
    <div class="bg-grain relative overflow-hidden rounded-[28px] bg-teal-deep px-6 py-12 text-white sm:px-10 md:px-14 md:py-16">
      <!-- Ruta decorativa dentro del bloque -->
      <svg class="pointer-events-none absolute inset-0 h-full w-full opacity-[0.16]" viewBox="0 0 1000 400" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
        <path d="M-20 80 C 200 20, 320 260, 540 200 S 900 60, 1100 220" fill="none" stroke="var(--color-yellow)" stroke-width="3" stroke-dasharray="2 14" stroke-linecap="round"></path>
      </svg>

      <div class="relative grid gap-10 md:grid-cols-[1.05fr_.95fr] md:items-center md:gap-14">
        <div data-reveal class="animate-fade-in-right timeline-view animate-range-[entry_0%_cover_30%]">
          <p class="kicker text-yellow">{TRAINING.kicker}</p>
          <h2 class="section-title mt-5 text-white">{TRAINING.title}</h2>
          <p class="mt-5 max-w-lg text-base leading-relaxed text-white/85">{TRAINING.paragraph}</p>

          <ul class="mt-8 grid gap-3.5 sm:grid-cols-2">
            {
              TRAINING.checklist.map((item) => (
                <li class="flex items-center gap-3 text-sm font-semibold text-white/95">
                  <span class="flex h-7 w-7 flex-none items-center justify-center rounded-full bg-yellow text-teal-deep">
                    <Icon name="check" size={16} strokeWidth={3} />
                  </span>
                  {item}
                </li>
              ))
            }
          </ul>
        </div>

        <!-- Tarjeta tipo "pase de abordaje" con la ruta de formación -->
        <div data-reveal class="animate-fade-in-left timeline-view animate-range-[entry_10%_cover_40%] animate-delay-200 relative rounded-2xl bg-white p-7 text-ink shadow-2xl">
          <div class="flex items-center gap-2 text-[0.7rem] font-extrabold uppercase tracking-[0.14em] text-ink-soft">
            <Icon name="smartphone" size={16} class="text-teal" />
            {TRAINING.routeLabel}
          </div>

          <div class="mt-5 flex flex-col gap-4">
            {
              TRAINING.route.map((item, i) => {
                const accent = ACCENTS[item.color as Accent];
                return (
                  <div class={`flex items-center gap-4 ${i === 0 ? "border-b border-dashed border-ink/15 pb-4" : ""}`}>
                    <div class={`title-display min-w-[84px] text-[2.6rem] leading-none ${accent.text}`}>
                      {item.hours}
                    </div>
                    <div>
                      <div class="text-sm font-extrabold text-ink">{item.title}</div>
                      <div class="mt-0.5 text-xs leading-snug text-ink-soft">{item.description}</div>
                    </div>
                  </div>
                );
              })
            }
          </div>

          <div class="mt-5 rounded-xl bg-yellow px-4 py-3.5 text-center text-sm font-extrabold text-ink">
            {TRAINING.total}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
