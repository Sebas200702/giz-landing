---
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { FAQ, whatsappHref } from "../data/site";

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: FAQ.items.map((item) => ({
    "@type": "Question",
    name: item.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.answer,
    },
  })),
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />

<section id="preguntas" class="scroll-mt-24 py-20 sm:py-28" style="content-visibility: auto">
  <div class="wrap grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:gap-14">
    <div class="md:sticky md:top-28 md:self-start">
      <p class="kicker text-teal">{FAQ.kicker}</p>
      <h2 class="section-title mt-5 text-teal-deep">{FAQ.title}</h2>
      <p class="lead mt-5">¿No encuentras tu respuesta? Escríbenos y te ayudamos.</p>
      <Button href={whatsappHref()} variant="outline-ink" class="mt-6" target="_blank" rel="noopener">
        Escríbenos por WhatsApp
      </Button>
    </div>

    <div data-reveal class="animate-slide-up-fade timeline-view animate-range-[entry_0%_cover_30%] flex flex-col gap-3.5">
      {
        FAQ.items.map((item, i) => (
          <details open={i === 0} class="faq-item group card overflow-hidden open:border-teal/30 open:shadow-[0_18px_40px_-24px_rgba(11,114,133,0.5)]">
            <summary class="flex cursor-pointer list-none items-center gap-4 px-6 py-5 transition-colors hover:bg-sand/60 [&::-webkit-details-marker]:hidden">
              <span class="title-display flex-none text-2xl text-teal/25 transition-colors group-open:text-teal">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="flex-1 text-[1.05rem] font-bold text-ink">{item.question}</span>
              <span class="flex-none text-teal transition-transform duration-300 group-open:rotate-180">
                <Icon name="chevron-down" size={22} />
              </span>
            </summary>
            <div class="faq-content">
              <p class="px-6 pb-6 pl-[4.15rem] text-[0.95rem] leading-relaxed text-ink-soft">{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  @supports (interpolate-size: allow-keywords) {
    .faq-content {
      interpolate-size: allow-keywords;
      transition:
        height 0.3s ease,
        opacity 0.25s ease;
    }

    details:not([open]) .faq-content {
      height: 0;
      opacity: 0;
      overflow: hidden;
    }

    details[open] .faq-content {
      height: auto;
      opacity: 1;
    }
  }
</style>
