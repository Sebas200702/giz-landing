---
import Icon from "./Icon.astro";
import Button from "./Button.astro";
import { REGISTRATION, ZOHO_FORM_URL } from "../data/site";
---

<section id="inscripcion" class="diag py-20 text-center text-white sm:py-28" style="--diag-color: var(--color-coral-strong)">
  <div class="diag-fill"></div>



  <div class="wrap relative max-w-2xl">
    <div data-reveal class="animate-fade-in-up timeline-view animate-range-[entry_0%_cover_30%]">
      <p class="kicker text-yellow justify-center before:bg-yellow">{REGISTRATION.kicker}</p>
      <h2 class="section-title mt-5 text-white">{REGISTRATION.title}</h2>
      <p class="mx-auto mt-4 max-w-md text-base leading-relaxed text-white/85">{REGISTRATION.paragraph}</p>
    </div>

    <!-- Tarjeta de CTA coincidente con la línea gráfica (estilo Pase de Abordaje / Training) -->
    <div
      data-reveal
      class="animate-fade-in-up timeline-view animate-range-[entry_10%_cover_40%] animate-delay-150 relative mx-auto mt-10 max-w-xl rounded-2xl bg-white p-7 text-ink shadow-2xl text-left"
    >
      <div class="flex items-center justify-between border-b border-dashed border-ink/15 pb-5">
        <div class="flex items-center gap-2 text-[0.7rem] font-extrabold uppercase tracking-[0.14em] text-ink-soft">
          <Icon name="user-check" size={16} class="text-coral-strong" />
          Proceso de Registro
        </div>
        <span class="inline-flex items-center rounded-full bg-coral/10 px-3 py-1 text-xs font-bold text-coral-strong">
          100% Gratuito
        </span>
      </div>

      <ul class="mt-6 flex flex-col gap-5">
        <li class="flex items-start gap-3.5">
          <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-coral-strong text-white mt-0.5">
            <Icon name="clock" size={13} strokeWidth={3} />
          </span>
          <div>
            <div class="text-sm font-extrabold text-ink">Registro rápido y sencillo</div>
            <div class="text-xs leading-snug text-ink-soft mt-0.5">Completa el formulario en línea en menos de 5 minutos desde tu celular.</div>
          </div>
        </li>
        <li class="flex items-start gap-3.5">
          <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-coral-strong text-white mt-0.5">
            <Icon name="check-square" size={13} strokeWidth={3} />
          </span>
          <div>
            <div class="text-sm font-extrabold text-ink">Sin intermediarios</div>
            <div class="text-xs leading-snug text-ink-soft mt-0.5">Tu postulación va directa a nuestro equipo de orientación laboral.</div>
          </div>
        </li>
        <li class="flex items-start gap-3.5">
          <span class="flex h-6 w-6 flex-none items-center justify-center rounded-full bg-coral-strong text-white mt-0.5">
            <Icon name="map-pin" size={13} strokeWidth={3} />
          </span>
          <div>
            <div class="text-sm font-extrabold text-ink">Bogotá, Cúcuta y Bucaramanga</div>
            <div class="text-xs leading-snug text-ink-soft mt-0.5">Válido para personas residentes en estas tres ciudades y sus áreas metropolitanas.</div>
          </div>
        </li>
      </ul>

      <div class="mt-8 flex flex-col items-center gap-3.5">
        <Button
          href={ZOHO_FORM_URL}
          variant="coral"
          target="_blank"
          rel="noopener noreferrer"
          class="w-full justify-center text-sm font-extrabold tracking-wider"
        >
          {REGISTRATION.cta}
          <Icon name="arrow-right" size={16} />
        </Button>
        <span class="text-[0.7rem] font-bold text-ink-soft uppercase tracking-wider text-center w-full block">
          Se abrirá en una nueva pestaña segura
        </span>
      </div>
    </div>
  </div>
</section>
