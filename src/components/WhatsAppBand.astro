---
import Button from "./Button.astro";
import IconWhatsapp from "./IconWhatsapp.astro";
import { WHATSAPP_BAND, whatsappHref } from "../data/site";
---

<section id="contacto" class="diag bubbles py-14 text-white" style="--diag-color: var(--color-teal); content-visibility: auto">
  <div class="diag-fill"></div>
  <div class="wrap relative flex flex-wrap items-center justify-between gap-6">
    <div class="flex items-center gap-4">
      <span class="hidden h-14 w-14 flex-none items-center justify-center rounded-2xl bg-white/12 text-white sm:flex">
        <IconWhatsapp size={28} />
      </span>
      <div>
        <h2 class="title-display text-2xl leading-none sm:text-[1.75rem]">{WHATSAPP_BAND.title}</h2>
        <p class="mt-2 text-base font-semibold text-white/90">{WHATSAPP_BAND.subtitle}</p>
      </div>
    </div>
    <Button href={whatsappHref()} variant="coral" target="_blank" rel="noopener">
      <IconWhatsapp size={18} />
      {WHATSAPP_BAND.cta}
    </Button>
  </div>
</section>
